{
  "name": "grlp-ai-executive-os",
  "version": "0.1.0",
  "private": true,
  "description": "GRLP AI Executive Operating System — AI Executive Administration & Real Estate Operations Assistant",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "mail:test": "tsx scripts/mail.ts test",
    "mail:ingest": "tsx scripts/mail.ts ingest",
    "import:masters": "tsx scripts/import-masters.ts",
    "load:master": "tsx scripts/load-master-text.ts",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "imapflow": "^1.0.171",
    "jose": "^5.9.6",
    "mailparser": "^3.7.1",
    "mammoth": "^1.8.0",
    "next": "^15.5.4",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
