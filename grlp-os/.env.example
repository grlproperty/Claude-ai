# ── Required ────────────────────────────────────────────────────────────────
SESSION_SECRET="generate with: openssl rand -base64 48"

# Running under Docker Compose? Set POSTGRES_PASSWORD instead — compose builds
# DATABASE_URL from it and runs the database for you. Set DATABASE_URL only
# when you are pointing at a database you host yourself.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/grlp_os"

# ── Docker Compose only ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=""
POSTGRES_USER="grlp"
POSTGRES_DB="grlp_os"
APP_PORT="3000"

# ── AI provider. Without this the AI endpoints refuse rather than fabricate. ─
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ── GRLP mailbox (IMAP + SMTP) ──────────────────────────────────────────────
# grproperty.co.za mail is hosted on rdsa-mail.com (xneelo), not Google or
# Microsoft, so this is a username and password — there is no OAuth client.
# Verify with: npm run mail:test
MAIL_IMAP_HOST="mail.grproperty.co.za"
MAIL_IMAP_PORT="993"
MAIL_SMTP_HOST="mail.grproperty.co.za"
MAIL_SMTP_PORT="587"
MAIL_USER="mandy@grproperty.co.za"
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="mandy@grproperty.co.za"
MAIL_FROM_NAME="Garden Route Lifestyle Property"

# ── Google Workspace (calendar and single sign-on only). ────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ── Microsoft 365 (Outlook mail + calendar). ────────────────────────────────
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID=""
MS_REDIRECT_URI=""

# ── Dropbox (document storage). ─────────────────────────────────────────────
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
DROPBOX_REFRESH_TOKEN=""
# Only needed for a Dropbox Business team account, to reach the team space.
DROPBOX_ROOT_NAMESPACE_ID=""

# ── WhatsApp Business Cloud API. Read-only: the system never replies. ───────
# Receiving needs no access token — only the app secret, to check a delivery
# really came from Meta. Run `npm run whatsapp:setup` for what to paste where.
#
# Meta app → Settings → Basic → App secret.
WHATSAPP_APP_SECRET=""
# Any long random string you invent. Meta only echoes it back to prove the
# webhook is yours: openssl rand -hex 24
WHATSAPP_VERIFY_TOKEN=""
# WhatsApp → API Setup. A long number of Meta's own, shown directly under the
# telephone number. It is NOT the telephone number; confusing the two gives a
# webhook that verifies, delivers, and then matches nothing.
WHATSAPP_PHONE_NUMBER_ID=""
# The number in dialling form, e.g. "+27 74 000 0000". Used to tell messages we
# sent from messages the client sent.
WHATSAPP_BUSINESS_NUMBER=""
# The WhatsApp Business Account the number sits in. Recorded for reference; no
# call is ever made to it.
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# The address this installation is reachable at, used to print the webhook URL.
PUBLIC_URL=""

# ── E-signature. No provider selected yet; signature routing stays manual. ──
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
