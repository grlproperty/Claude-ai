# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/grlp_os"
SESSION_SECRET="generate with: openssl rand -base64 48"

# ── AI provider. Without this the AI endpoints refuse rather than fabricate. ─
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ── Google Workspace (Gmail + Calendar). Not connected until all three set. ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ── Microsoft 365 (Outlook mail + calendar). ────────────────────────────────
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID=""
MS_REDIRECT_URI=""

# ── Dropbox (document storage). ─────────────────────────────────────────────
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
DROPBOX_REFRESH_TOKEN=""

# ── E-signature. No provider selected yet; signature routing stays manual. ──
ESIGN_PROVIDER=""
ESIGN_API_KEY=""
