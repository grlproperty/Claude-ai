# Apache configuration for shared hosting (cPanel, Plesk, most paid hosts).
#
# The site is plain HTML in real directories, so it serves correctly with no
# configuration at all. Everything here is an improvement on that baseline
# rather than a requirement, except the error document.

# Without this a mistyped address gets the host's default error page instead
# of the site's own.
ErrorDocument 404 /404.html

# Some older servers do not know these and send them as plain text, which
# means no images and no fonts.
<IfModule mod_mime.c>
  AddType image/webp                     .webp
  AddType font/woff2                     .woff2
  AddType application/manifest+json      .webmanifest
  AddType application/rss+xml            .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Images and fonts are content-addressed in practice — a changed image gets a
# changed name — so they can be held for a long time. HTML must not be.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  # text/html is deliberately absent — Cache-Control below owns it.
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # The page itself must never be served from a cache without asking first.
  #
  # Without this the server sends no Cache-Control at all, only Last-Modified,
  # and a browser is then free to guess a lifetime from it — the usual guess is
  # a tenth of the file's age, which for a file edited a week ago is most of a
  # day. That is how a site that has just been re-uploaded keeps showing the
  # old one, with no way for the reader to know.
  #
  # no-cache does not mean do not store. It means store it, but revalidate
  # every time — so an unchanged page still comes back as a 304 with no body,
  # and a changed one arrives immediately.
  <FilesMatch "\.(html|xml|json|webmanifest|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Assets are versioned by name, so they can be held indefinitely.
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# If the host does not already force HTTPS, uncomment these three lines.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>
