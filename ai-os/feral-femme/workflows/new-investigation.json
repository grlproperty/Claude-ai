    { "id": "briefing", "name": "Research briefing distribution", "agent": "FF-A058", "run": "briefing.prepare" },
    { "id": "social", "name": "Social content prepared", "agent": "FF-A061", "run": "social.prepare", "gate": { "action": "social.publish", "title": "Social posts — {{input.title}}" } },
    { "id": "archive", "name": "Archive updated", "agent": "FF-A063", "run": "archive.update" }
  ]
