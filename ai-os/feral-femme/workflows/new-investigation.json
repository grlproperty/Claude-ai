    { "id": "brief", "name": "Research brief created", "agent": "FF-A009", "run": "research.brief" },
    { "id": "sources", "name": "Public sources gathered", "agent": "FF-A011", "run": "sources.register" },
    { "id": "verify", "name": "Sources checked", "agent": "FF-A025", "run": "source.verify" },
    { "id": "classify", "name": "Evidence categorised", "agent": "FF-A027", "run": "evidence.classify" },
    { "id": "sheet", "name": "Sources verified by a person", "agent": "FF-A033", "run": "verification.sheet", "gate": { "action": "source.verification.confirm", "title": "Confirm each claim against its source — {{input.title}}" } },
    { "id": "draft", "name": "Editorial draft produced", "agent": "FF-A034", "run": "draft.fieldnote" },
    { "id": "factcheck", "name": "Fact-checking completed", "agent": "FF-A043", "run": "fact.check" },
    { "id": "voice", "name": "Editorial voice checked", "agent": "FF-A040", "run": "voice.check" },
    { "id": "review", "name": "Editorial review requested", "agent": "FF-A003", "run": "editorial.review", "gate": { "action": "editorial.review", "title": "Editorial review — {{input.title}}" } },
    { "id": "visual", "name": "Visual essay brief created", "agent": "FF-A045", "run": "visual.brief" },
