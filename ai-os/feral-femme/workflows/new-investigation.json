  "required": ["title", "industry", "question"],
  "example": {
    "title": "SAMPLE — When a net-zero pledge is treated as a consumer claim",
    "industry": "Food & Agriculture",
    "question": "What does the public record show about the New York Attorney General's case over JBS USA's net-zero marketing?",
    "summary": "A sample note assembled from one entry already in the Record Checker.",
    "sources": [
      { "publisher": "NY Attorney General", "title": "Attorney General James sues JBS USA over net zero climate claims (press release)", "url": "https://ag.ny.gov/press-release/2024/attorney-general-james-sues-jbs-usa-fraudulent-net-zero-climate-claims", "date": "2024-02", "type": "primary" }
    ],
    "claims": [
      { "text": "The New York Attorney General sued JBS USA in February 2024, alleging that its \"Net Zero by 2040\" marketing misled consumers.", "classification": "allegation", "sources": [1] },
      { "text": "The case tests whether a corporate climate pledge can be treated as a claim made to consumers.", "classification": "editorial_interpretation" },
      { "text": "The outcome of the case is not recorded in this sample.", "classification": "unresolved" }
    ],
    "sample": true
  },
  "steps": [
