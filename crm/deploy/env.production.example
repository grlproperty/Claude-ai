# ---------------------------------------------------------------------
# Copy to .env.production beside docker-compose.yml, fill in, then:
#   chmod 600 .env.production
#
# Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Nothing in this file may be committed, and nothing in it reaches the
# browser.
# ---------------------------------------------------------------------

# The domain the CRM answers on. Point its A record at this server first,
# or Caddy cannot get a certificate.
CRM_DOMAIN=crm.grproperty.co.za

# --- Database -------------------------------------------------------------
# Two roles, two passwords, on purpose. The owner runs migrations; the app
# serves requests and cannot step around row level security.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# --- Secrets --------------------------------------------------------------
SESSION_SECRET=

# The pepper for the one-way fingerprint of identity numbers.
#
# SET THIS ONCE AND NEVER CHANGE IT. Changing it does not break sign-in, but
# every existing identity fingerprint becomes unmatchable, so duplicate
# detection on ID numbers silently stops working for records already
# captured. Keep it wherever you keep the database password.
IDENTITY_PEPPER=

# --- Access ---------------------------------------------------------------
ALLOWED_EMAIL_DOMAINS=grproperty.co.za
SESSION_HOURS=12

# --- Storage --------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- Connections ----------------------------------------------------------
# Each request takes one connection for the length of its transaction.
# Keep this comfortably under the database's max_connections.
PG_POOL_MAX=10

# --- Backups (used by deploy/backup.sh, not by the application) -----------
# An age public key. With it, the server can write backups and never read
# them back, so a compromised server cannot decrypt its own history.
#   age-keygen -o backup-key.txt   # keep the private half OFF this server
AGE_RECIPIENT=

# Where the backup goes afterwards. A backup beside the thing it backs up
# is not a backup. Use object storage in the same country as the data.
OFFSITE_RCLONE_REMOTE=
