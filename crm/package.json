{
  "name": "grlp-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Garden Route Lifestyle Property \u2014 internal CRM. Find your way home.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/reset.ts",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "ci": "npm run typecheck && npm run lint && npm run migrate && npm test && npm run build",
    "test:watch": "node --env-file-if-exists=.env.local --test --watch \"test/**/*.test.ts\"",
    "smoke": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/smoke.ts",
    "handover": "node --experimental-strip-types scripts/handover.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
