# --- Database -------------------------------------------------------------
# The application connects as a role with neither SUPERUSER nor BYPASSRLS so
# that row level security is genuinely enforced.
DATABASE_URL=postgres://grlp_app:grlp_app_dev@127.0.0.1:5432/grlp_crm
# Used by migrations only, never to serve a request.
DATABASE_ADMIN_URL=postgres://grlp_owner:grlp_owner_dev@127.0.0.1:5432/grlp_crm

# --- Secrets --------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-32-random-bytes
# Pepper for the one-way fingerprint of identity numbers. Changing this makes
# existing fingerprints unmatchable, so set it once and keep it safe.
IDENTITY_PEPPER=change-me-to-32-random-bytes

# --- Access ---------------------------------------------------------------
ALLOWED_EMAIL_DOMAINS=grproperty.co.za
SESSION_HOURS=12

# --- Storage --------------------------------------------------------------
# 'local' keeps files in a private directory outside the web root. Files are
# only ever served through an authorised route handler.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_BYTES=26214400

# Supabase Storage is supported but not configured. Without these the
# Settings > System health screen shows the driver as NOT CONNECTED rather
# than pretending an upload succeeded.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=grlp-private
