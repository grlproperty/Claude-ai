{
  "name": "feral-femme",
  "version": "1.0.0",
  "private": true,
  "description": "FERAL FEMME \u2014 editorial, research, and free sustainability tools across ten industries.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "cage": "node scripts/build-cage.mjs",
    "dev": "node scripts/dev-server.mjs",
    "new": "node scripts/new-entry.mjs",
    "social": "node scripts/social-kit.mjs",
    "check": "node scripts/check.mjs",
    "ci": "npm run build && npm run check",
    "instagram": "node scripts/pull-instagram.mjs",
    "rates": "node scripts/pull-rates.mjs",
    "briefing": "node scripts/send-briefing.mjs",
    "single": "node src/build.mjs && node scripts/build-single.mjs",
    "products": "node src/build.mjs && node products/build.mjs",
    "sources": "node scripts/check-sources.mjs",
    "products:check": "node scripts/check-products.mjs"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^12.0.2",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4"
  }
}
